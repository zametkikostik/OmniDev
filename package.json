{
  "name": "omnidev",
  "version": "0.8.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@omnidev/web",
    "build": "npm run build --workspace=@omnidev/web",
    "start": "npm run start --workspace=@omnidev/web",
    "db:generate": "npm run generate --workspace=@omnidev/db",
    "db:push": "npm run push --workspace=@omnidev/db",
    "health": "curl -s http://localhost:3000/api/health"
  },
  "engines": { "node": ">=20" }
}
